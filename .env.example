# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Places (Text Search + Place Details) — required for live place search
# Enable Places API in Google Cloud Console, then paste the key here and restart `next dev`.
GOOGLE_PLACES_API_KEY=

# Receipt AI autofill (POST /api/parse-receipt)
# Prefer Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — unused for model list (fixed to gemini-2.0-flash → gemini-1.5-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Fallback OpenAI Vision
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# KakaoTalk share (optional — without this key, share copies text to clipboard)
# https://developers.kakao.com/ → JavaScript 키
# NEXT_PUBLIC_KAKAO_JS_KEY=
