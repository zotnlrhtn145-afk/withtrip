# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Places (Text Search + Place Details) — server-only, for /api/places/search
# Enable Places API in Google Cloud Console, then paste the key here and restart `next dev`.
GOOGLE_PLACES_API_KEY=

# Google Maps JavaScript API (browser) — 주변 스팟 지도 / AdvancedMarker
# Same key can work if Maps JavaScript API is enabled; prefer a browser-restricted key.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
# Optional Map ID for Advanced Markers (Cloud Console → Map Management). Defaults to DEMO_MAP_ID.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Receipt AI autofill (POST /api/parse-receipt)
# Prefer Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — unused for model list (fixed to gemini-2.0-flash → gemini-1.5-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Fallback OpenAI Vision
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# KakaoTalk share (optional — without this key, share copies text to clipboard)
# https://developers.kakao.com/ → JavaScript 키
# NEXT_PUBLIC_KAKAO_JS_KEY=

# Uber ride-request deep link for overseas 길찾기 (optional — without this key,
# the 길찾기 popover just shows 구글 지도 for destinations outside Korea).
# https://developer.uber.com/dashboard → Create App → Client ID
# NEXT_PUBLIC_UBER_CLIENT_ID=
